generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url    = env("DATABASE_URL")
}

model Product {
  id          String   @id @default(uuid())
  name        String
  slug        String  @unique
  description String
  price       Float
  stock       Int
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  images      ProductImage[]
}

model Category {
  id   String @id @default(uuid())
  name String @unique
  products Product[]
}

model ProductImage {
  id        String @id @default(uuid())
  url       String
  productId String
  product   Product @relation(fields: [productId], references: [id])
}