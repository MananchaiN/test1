generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url    = env("DATABASE_URL")
}

model Review {
  id        Int    @id @default(autoincrement())
  productId String
  userId    String
  rating    Int    @default(0)
  comment   String
  createdAt DateTime @default(now())

  @@index([productId, userId], name: "user_product_idx")
}